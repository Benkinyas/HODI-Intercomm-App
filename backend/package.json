{
  "name": "hodi-backend",
  "version": "1.0.0",
  "description": "HODI Urgent Paging System - Firebase 2nd Gen Cloud Functions & Google Cloud Tasks Engine",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase serve --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": "18"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/tasks": "^5.0.0",
    "africastalking": "^0.6.2",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.6.0",
    "twilio": "^4.19.3"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "^5.3.3"
  },
  "private": true
}
